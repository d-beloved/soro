# Copy to engine/aws/.env on the server (never commit it).
# Same value as ENGINE_TOKEN in the gateway's settings and the Modal secret, so the gateway's fallback works with one token.
ENGINE_TOKEN=
# The engine's public name: a Route 53 hosted zone of its own, whose A record update-dns.sh sets at every boot.
ENGINE_DOMAIN=engine.soro.charavol.com
