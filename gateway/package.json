{
  "name": "soroengine-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export:csv": "tsx --env-file=.env src/scripts/exportCsv.ts",
    "tips:sync": "tsx --env-file=.env src/scripts/syncTips.ts",
    "locales:translate": "tsx --env-file=.env src/scripts/translateLocales.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
