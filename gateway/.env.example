# --- WhatsApp Cloud API (Meta) ---
# Any random string; you paste the same value into the Meta webhook settings.
WA_VERIFY_TOKEN=
# App Dashboard -> App settings -> Basic -> App secret
WA_APP_SECRET=
# System-user permanent token with whatsapp_business_messaging permission
WA_ACCESS_TOKEN=
# WhatsApp -> API Setup -> Phone number ID
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v25.0

# --- Engine (AWS GPU server, the Modal GPU service, or http://localhost:8000 when running locally) ---
ENGINE_URL=http://localhost:8000
# Must match ENGINE_TOKEN in the engine's env (engine/aws/.env, the Modal secret, or your shell)
ENGINE_TOKEN=
# Optional: a second engine with the same token, used when ENGINE_URL fails (the Modal URL, behind AWS)
ENGINE_FALLBACK_URL=
# Optional: ms to wait for ENGINE_URL before the fallback (default 60000 with a fallback, else 120000)
ENGINE_TIMEOUT_MS=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Privacy ---
# Random 32+ char string. Never change it after launch or users get new hashes.
PHONE_HASH_SALT=
# Seals the phone number of a pending reminder: openssl rand -base64 32. Unset = no reminders.
NUDGE_KEY=
PRIVACY_URL=https://soro.charavol.com/privacy
# The bot's public WhatsApp number, digits only (used in SHARE links)
WA_PUBLIC_NUMBER=2349077485454

# on | off  (turn off if TTS is slow or failing; text replies always go out)
VOICE_REPLIES=on
LOG_LEVEL=info
PORT=3000
